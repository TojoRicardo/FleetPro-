APP_NAME=FleetPro
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging-api.fleetpro.example

LOG_CHANNEL=stack
LOG_STACK=json,single
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=fleetpro_staging
DB_USERNAME=postgres
DB_PASSWORD=

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_HOST=redis
REDIS_PORT=6379

SANCTUM_TOKEN_EXPIRATION=480
SANCTUM_STATEFUL_DOMAINS=staging.fleetpro.example

REFRESH_TOKEN_ENABLED=true
REFRESH_TOKEN_TTL_DAYS=14

CORS_ALLOWED_ORIGINS=https://staging.fleetpro.example
ALLOW_PUBLIC_REGISTRATION=false

STRIPE_KEY=your_stripe_publishable_key_here
STRIPE_SECRET=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=14

FRONTEND_URL=https://staging.fleetpro.example
