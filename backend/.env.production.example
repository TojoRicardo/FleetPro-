APP_NAME=FleetPro
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.fleetpro.example

LOG_CHANNEL=stack
LOG_STACK=json
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=fleetpro
DB_USERNAME=
DB_PASSWORD=

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_HOST=redis
REDIS_PORT=6379

SANCTUM_TOKEN_EXPIRATION=480
SANCTUM_STATEFUL_DOMAINS=app.fleetpro.example

REFRESH_TOKEN_ENABLED=true
REFRESH_TOKEN_TTL_DAYS=7

CORS_ALLOWED_ORIGINS=https://app.fleetpro.example
ALLOW_PUBLIC_REGISTRATION=false

STRIPE_KEY=your_stripe_publishable_key_here
STRIPE_SECRET=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"

REQUEST_LOGGING_ENABLED=true
HEALTH_CHECK_QUEUE=true

FRONTEND_URL=https://app.fleetpro.example
