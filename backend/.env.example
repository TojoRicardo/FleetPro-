APP_NAME=FleetPro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:9000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database — use sqlite for local dev, pgsql for staging/production
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=fleetpro
# DB_USERNAME=postgres
# DB_PASSWORD=your_password_here

SESSION_DRIVER=file
SESSION_LIFETIME=120

QUEUE_CONNECTION=sync
CACHE_STORE=file

# Sanctum
SANCTUM_TOKEN_EXPIRATION=480
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# Auth security
REFRESH_TOKEN_ENABLED=true
REFRESH_TOKEN_TTL_DAYS=30

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Security
ALLOW_PUBLIC_REGISTRATION=true
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_DECAY=1
AUTH_REGISTER_RATE_LIMIT=3
DASHBOARD_CACHE_TTL=60

# Monitoring
REQUEST_LOGGING_ENABLED=true
REQUEST_LOG_CHANNEL=requests
METRICS_CACHE_TTL=30
HEALTH_CHECK_QUEUE=false

# Backup
BACKUP_ENABLED=true
BACKUP_DISK=local
BACKUP_PATH=backups/database
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"
PG_DUMP_BINARY=pg_dump

# Broadcasting
BROADCAST_CONNECTION=log
REVERB_APP_ID=your_reverb_app_id
REVERB_APP_KEY=your_reverb_key_here
REVERB_APP_SECRET=your_reverb_secret_here
REVERB_HOST=127.0.0.1
REVERB_PORT=8080

# Redis (staging/production)
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# Stripe — required in staging/production for billing
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

FRONTEND_URL=http://localhost:5173

# Realtime broadcast (optional)
REALTIME_BROADCAST_URL=http://localhost:6001/broadcast
REALTIME_INTERNAL_SECRET=your_realtime_secret_here
